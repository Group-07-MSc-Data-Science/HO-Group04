@prefix rr:       <http://www.w3.org/ns/r2rml#> .
@prefix rml:      <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:       <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix geo:      <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gsp:      <http://www.opengis.net/ont/geosparql#> .
@prefix schema:   <http://schema.org/> .
@prefix esadm:    <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> .
@prefix esdir:    <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix edintmed: <https://edint.es/def/medio-ambiente#> .
@prefix edintinf: <https://edint.es/def/infraestructura#> .
@prefix bpm:      <https://w3id.org/breatheplay-madrid/ontology#> .
@base             <https://w3id.org/breatheplay-madrid/mappings/instalaciones-deportivas-reuse#> .

# Group04 - Breathe & Play Madrid - Hands-on 6 (ontology reuse).
# Run from the HandsOn/Group04 directory (python mappings/generate_rdf-reuse.py).
# Dataset: Instalaciones deportivas municipales básicas (Ayuntamiento de Madrid, 200215)
# Sources: csv/200215-0-instalaciones-deportivas-csv-csv-updated-with-links.csv (Hands-on 5)
#          csv/edint-infrastructure-types.csv (correspondence table: Madrid facility
#          type -> EDINT infrastructure type)
#
# Model: facilities are EDINT facilities (edintinf:Facility) with an EDINT
# infrastructure type, accessibility, district and neighbourhood (edintinf:belongsTo),
# a GeoSPARQL geometry and a postal address (Spanish direccion-postal vocabulary).

# ---------------------------------------------------------------------------
# Sports facilities
# ---------------------------------------------------------------------------
<#SportsFacilityMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/sports-facility/{PK}" ;
        rr:termType rr:IRI ;
        rr:class edintinf:Facility
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOMBRE" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "PK" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    # EDINT infrastructure type that corresponds to the Madrid facility type
    # (join TIPO_ID = TIPO_ID of the correspondence table; "Pistas Tenis Badminton"
    # has two EDINT types)
    rr:predicateObjectMap [
        rr:predicate edintinf:hasInfrastructureType ;
        rr:objectMap [
            rr:parentTriplesMap <#InfrastructureTypeMap> ;
            rr:joinCondition [ rr:child "TIPO_ID" ; rr:parent "TIPO_ID" ]
        ]
    ] ;

    # Madrid facility type (SKOS list mapped to the EDINT types, same IRIs as in version 1)
    rr:predicateObjectMap [
        rr:predicate edintinf:hasInfrastructureType ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/facility-type/{TIPO_ID}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # EDINT represents accessibility as text ("Accesible", "Parcialmente accesible"...)
    rr:predicateObjectMap [
        rr:predicate edintinf:accessibility ;
        rr:objectMap [ rml:reference "ACCESIBILIDAD_NOMBRE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:equipment ;
        rr:objectMap [ rml:reference "EQUIPAMIENTO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:transportInfo ;
        rr:objectMap [ rml:reference "TRANSPORTE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:url ;
        rr:objectMap [ rml:reference "CONTENT-URL" ; rr:termType rr:Literal ; rr:datatype xsd:anyURI ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:address ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/postal-address/sports-facility/{PK}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:lat ;
        rr:objectMap [ rml:reference "LATITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:long ;
        rr:objectMap [ rml:reference "LONGITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsp:hasGeometry ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/geometry/sports-facility/{PK}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate edintinf:belongsTo ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Not generated for the 8 rows with an empty BARRIO_ID
    rr:predicateObjectMap [
        rr:predicate edintinf:belongsTo ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/neighbourhood/{BARRIO_ID}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link to the air quality stations dataset (no equivalent in EDINT):
    # join ESTACION_CERCANA (this CSV) = CODIGO (stations CSV)
    rr:predicateObjectMap [
        rr:predicate bpm:hasNearestStation ;
        rr:objectMap [
            rr:parentTriplesMap <#MonitoringStationMap> ;
            rr:joinCondition [ rr:child "ESTACION_CERCANA" ; rr:parent "CODIGO" ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:distanceToNearestStation ;
        rr:objectMap [ rml:reference "DISTANCIA_ESTACION_KM" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] .

# ---------------------------------------------------------------------------
# Monitoring stations (parent of the join above). Same IRI pattern and type as in
# estaciones-control-aire-reuse.rml, so the resources merge across datasets.
# ---------------------------------------------------------------------------
<#MonitoringStationMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/station/{CODIGO}" ;
        rr:termType rr:IRI ;
        rr:class edintmed:SensorPlatform
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "ESTACION" ; rr:termType rr:Literal ; rr:language "es" ]
    ] .

# ---------------------------------------------------------------------------
# Infrastructure types (from the correspondence table). Most are EDINT concepts;
# "tenis-mesa" and "pista-pickleball" are our own concepts (ontology/breatheplay-kos.ttl).
# ---------------------------------------------------------------------------
<#InfrastructureTypeMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/edint-infrastructure-types.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rml:reference "EDINT_TYPE" ;
        rr:termType rr:IRI ;
        rr:class skos:Concept
    ] .

# ---------------------------------------------------------------------------
# Madrid facility types (TIPO_ID) as a SKOS list mapped to the EDINT types with
# skos:exactMatch, skos:closeMatch or skos:broadMatch (column SKOS_MATCH).
# Same IRIs as the facility types of version 1 (resource/facility-type/{TIPO_ID}).
# ---------------------------------------------------------------------------
<#MadridFacilityTypeMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/edint-infrastructure-types.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/facility-type/{TIPO_ID}" ;
        rr:termType rr:IRI ;
        rr:class skos:Concept
    ] ;

    rr:predicateObjectMap [
        rr:predicate skos:prefLabel ;
        rr:objectMap [ rml:reference "TIPO_NOMBRE" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rml:reference "TIPO_ID" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <https://w3id.org/breatheplay-madrid/kos/MadridFacilityTypes> ]
    ] ;

    rr:predicateObjectMap [
        rr:predicateMap [ rml:reference "SKOS_MATCH" ] ;
        rr:objectMap [ rml:reference "EDINT_TYPE" ; rr:termType rr:IRI ]
    ] .

# ---------------------------------------------------------------------------
# Geometries (GeoSPARQL WKT points: longitude latitude)
# ---------------------------------------------------------------------------
<#FacilityGeometryMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/geometry/sports-facility/{PK}" ;
        rr:termType rr:IRI ;
        rr:class gsp:Geometry
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:template "Ubicación de {NOMBRE}" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsp:asWKT ;
        rr:objectMap [
            rr:template "POINT({LONGITUD} {LATITUD})" ;
            rr:termType rr:Literal ;
            rr:datatype gsp:wktLiteral
        ]
    ] .

# ---------------------------------------------------------------------------
# Postal addresses (street and postal code; 6 facilities have no street and
# 2 have no postal code: those triples are not generated)
# ---------------------------------------------------------------------------
<#FacilityAddressMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/postal-address/sports-facility/{PK}" ;
        rr:termType rr:IRI ;
        rr:class esdir:DireccionPostal
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:template "Dirección de {NOMBRE}" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:streetAddress ;
        rr:objectMap [ rml:reference "DIRECCION" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:postalCode ;
        rr:objectMap [ rml:reference "CODIGO-POSTAL" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:addressLocality ;
        rr:objectMap [ rr:constant "Madrid" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] .

# ---------------------------------------------------------------------------
# Districts (Spanish territorio vocabulary, linked to Wikidata)
# ---------------------------------------------------------------------------
<#DistrictMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
        rr:termType rr:IRI ;
        rr:class esadm:Distrito
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "COD-DISTRITO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "DISTRITO_WIKIDATA" ; rr:termType rr:IRI ]
    ] .

# ---------------------------------------------------------------------------
# Neighbourhoods (Spanish territorio vocabulary, linked to Wikidata)
# ---------------------------------------------------------------------------
<#NeighbourhoodMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/neighbourhood/{BARRIO_ID}" ;
        rr:termType rr:IRI ;
        rr:class esadm:Barrio
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "BARRIO_ID" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    # The neighbourhood is within its district (GeoSPARQL)
    rr:predicateObjectMap [
        rr:predicate gsp:sfWithin ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "BARRIO_WIKIDATA" ; rr:termType rr:IRI ]
    ] .
