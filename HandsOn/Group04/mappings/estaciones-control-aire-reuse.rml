@prefix rr:       <http://www.w3.org/ns/r2rml#> .
@prefix rml:      <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:       <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix geo:      <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gsp:      <http://www.opengis.net/ont/geosparql#> .
@prefix schema:   <http://schema.org/> .
@prefix esadm:    <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> .
@prefix esdir:    <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix edintmed: <https://edint.es/def/medio-ambiente#> .
@prefix edintinf: <https://edint.es/def/infraestructura#> .
@prefix bpm:      <https://w3id.org/breatheplay-madrid/ontology#> .
@base             <https://w3id.org/breatheplay-madrid/mappings/estaciones-control-aire-reuse#> .

# Group04 - Breathe & Play Madrid - Hands-on 6 (ontology reuse).
# Run from the HandsOn/Group04 directory (python mappings/generate_rdf-reuse.py).
# Dataset: Estaciones de control de la calidad del aire (Ayuntamiento de Madrid, 212629)
# Source:  csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv (Hands-on 5)
#
# Model: stations are EDINT sensor platforms (edintmed:SensorPlatform) with a
# GeoSPARQL geometry and a postal address (Spanish direccion-postal vocabulary);
# districts and neighbourhoods use the Spanish territorio vocabulary.

# ---------------------------------------------------------------------------
# Monitoring stations
# ---------------------------------------------------------------------------
<#MonitoringStationMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/station/{CODIGO}" ;
        rr:termType rr:IRI ;
        rr:class edintmed:SensorPlatform
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "ESTACION" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "CODIGO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:lat ;
        rr:objectMap [ rml:reference "LATITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:long ;
        rr:objectMap [ rml:reference "LONGITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:alt ;
        rr:objectMap [ rml:reference "ALTITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsp:hasGeometry ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/geometry/station/{CODIGO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:address ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/postal-address/station/{CODIGO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:startDate ;
        rr:objectMap [ rml:reference "FECHA_ALTA" ; rr:termType rr:Literal ; rr:datatype xsd:date ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:hasStationType ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/station-type/{COD_TIPO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # District and neighbourhood of the station (Hands-on 5 columns)
    rr:predicateObjectMap [
        rr:predicate edintinf:belongsTo ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Only 5 stations have a neighbourhood (empty BARRIO_ID -> no triple)
    rr:predicateObjectMap [
        rr:predicate edintinf:belongsTo ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/neighbourhood/{BARRIO_ID}" ;
            rr:termType rr:IRI
        ]
    ] .

# ---------------------------------------------------------------------------
# Geometries (GeoSPARQL WKT points: longitude latitude)
# ---------------------------------------------------------------------------
<#StationGeometryMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/geometry/station/{CODIGO}" ;
        rr:termType rr:IRI ;
        rr:class gsp:Geometry
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:template "Ubicación de la estación {ESTACION}" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate gsp:asWKT ;
        rr:objectMap [
            rr:template "POINT({LONGITUD} {LATITUD})" ;
            rr:termType rr:Literal ;
            rr:datatype gsp:wktLiteral
        ]
    ] .

# ---------------------------------------------------------------------------
# Postal addresses
# ---------------------------------------------------------------------------
<#StationAddressMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/postal-address/station/{CODIGO}" ;
        rr:termType rr:IRI ;
        rr:class esdir:DireccionPostal
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:template "Dirección de la estación {ESTACION}" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:streetAddress ;
        rr:objectMap [ rml:reference "DIRECCION" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:addressLocality ;
        rr:objectMap [ rr:constant "Madrid" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] .

# ---------------------------------------------------------------------------
# Station types (ut Urbana tráfico, uf Urbana fondo, s Suburbana)
# ---------------------------------------------------------------------------
<#StationTypeMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/station-type/{COD_TIPO}" ;
        rr:termType rr:IRI ;
        rr:class bpm:StationType
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOM_TIPO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "COD_TIPO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] .

# ---------------------------------------------------------------------------
# Districts (Spanish territorio vocabulary, linked to Wikidata)
# ---------------------------------------------------------------------------
<#DistrictMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
        rr:termType rr:IRI ;
        rr:class esadm:Distrito
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "COD-DISTRITO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "DISTRITO_WIKIDATA" ; rr:termType rr:IRI ]
    ] .

# ---------------------------------------------------------------------------
# Neighbourhoods (Spanish territorio vocabulary, linked to Wikidata)
# ---------------------------------------------------------------------------
<#NeighbourhoodMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/neighbourhood/{BARRIO_ID}" ;
        rr:termType rr:IRI ;
        rr:class esadm:Barrio
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rml:reference "BARRIO_ID" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    # The neighbourhood is within its district (GeoSPARQL)
    rr:predicateObjectMap [
        rr:predicate gsp:sfWithin ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "BARRIO_WIKIDATA" ; rr:termType rr:IRI ]
    ] .
